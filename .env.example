# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Reverse image search (need at least one) ---

# Google Lens via SerpAPI. Broad coverage, distinguishes exact vs visual matches.
# Requires the query image to be fetchable over HTTP (use --upload or --image-url).
# Free tier: https://serpapi.com
SERPAPI_API_KEY=

# TinEye. Accepts the LOCAL file directly - no upload to any third-party bin.
# Exact/derivative index only. https://services.tineye.com
TINEYE_API_KEY=

# --- Ethereum Sepolia testnet ---

# Any Sepolia JSON-RPC endpoint (Alchemy, Infura, or a public node).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a THROWAWAY Sepolia test wallet holding only faucet ETH.
# NEVER put a key here that controls real funds on Ethereum mainnet.
# Only needed to WRITE. Independent verification needs no key at all.
PRIVATE_KEY=

# Address printed by: python scripts/deploy_contract.py
CONTRACT_ADDRESS=
